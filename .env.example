# 模型配置
MODEL_PROVIDER="OPENAI"  # 可选: OPENAI, ANTHROPIC, OLLAMA
MODEL_NAME="gpt-4o"  # 模型名称
MODEL_TEMPERATURE=0.7  # 温度参数 (0.0-2.0)
MODEL_API_KEY="your-api-key-here"  # API密钥
MODEL_BASE_URL=""  # 可选: 自定义API端点

# OpenAI API (当使用标准OpenAI时)
OPENAI_API_KEY="your-openai-api-key"

# Anthropic API (当使用Claude时)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# LangSmith追踪 (可选)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key"
LANGCHAIN_PROJECT="agentk"